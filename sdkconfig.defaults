# ESP32-S3 Modbus Diagnostic Tool - Default Config

# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (if available)
# 注：v5.x 起 PSRAM 开关用 CONFIG_SPIRAM，旧写法（带 ESP32S3 前缀的那个符号）已弃用，
# 会在 reconfigure 时提示 "was replaced with"——用新名，勿改回。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# UART
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# SPI
CONFIG_SPI_MASTER_IN_IRAM=y

# ADC
CONFIG_ADC_DISABLE_DAC=y
CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE=y
# 注：ADC 连续模式没有 "CTRL_FUNC_IN_IRAM" 选项（那是 oneshot 的
# ADC_ONESHOT_CTRL_FUNC_IN_IRAM）。曾误配 CONFIG_ADC_CONTINUOUS_CTRL_FUNC_IN_IRAM=y
# （未知符号，构建告警）——勿加回。

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
